<!DOCTYPE html>

<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mentoring Agenta Premium · Marcin Dutkiewicz</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
–gold: #C9A84C;
–gold-light: #E8C97A;
–gold-dim: rgba(201,168,76,0.15);
–dark: #0E0E0E;
–dark2: #161616;
–dark3: #1E1E1E;
–mid: #2A2A2A;
–text: #D4D0C8;
–text-dim: #7A7670;
–white: #F5F2EC;
}

html { scroll-behavior: smooth; }

body {
background: var(–dark);
color: var(–text);
font-family: ‘DM Sans’, sans-serif;
font-weight: 300;
font-size: 16px;
line-height: 1.7;
overflow-x: hidden;
}

/* ── NOISE TEXTURE ─────────────────────────── */
body::before {
content: ‘’;
position: fixed; inset: 0;
background-image: url(“data:image/svg+xml,%3Csvg viewBox=‘0 0 256 256’ xmlns=‘http://www.w3.org/2000/svg’%3E%3Cfilter id=‘noise’%3E%3CfeTurbulence type=‘fractalNoise’ baseFrequency=‘0.9’ numOctaves=‘4’ stitchTiles=‘stitch’/%3E%3C/filter%3E%3Crect width=‘100%25’ height=‘100%25’ filter=‘url(%23noise)’ opacity=‘0.03’/%3E%3C/svg%3E”);
pointer-events: none; z-index: 0; opacity: .4;
}

/* ── NAV ───────────────────────────────────── */
nav {
position: fixed; top: 0; left: 0; right: 0;
z-index: 100;
display: flex; align-items: center; justify-content: space-between;
padding: 24px 60px;
background: linear-gradient(to bottom, rgba(14,14,14,0.95), transparent);
backdrop-filter: blur(2px);
}

.nav-logo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px;
font-weight: 300;
letter-spacing: 0.12em;
color: var(–gold);
text-decoration: none;
}

.nav-cta {
font-size: 12px;
letter-spacing: 0.15em;
text-transform: uppercase;
color: var(–gold);
border: 1px solid var(–gold);
padding: 10px 28px;
text-decoration: none;
transition: all 0.3s;
}
.nav-cta:hover { background: var(–gold); color: var(–dark); }

/* ── HERO ──────────────────────────────────── */
.hero {
min-height: 100vh;
display: flex; flex-direction: column; justify-content: flex-end;
padding: 0 60px 100px;
position: relative;
overflow: hidden;
}

.hero-bg {
position: absolute; inset: 0;
background:
radial-gradient(ellipse 60% 60% at 80% 20%, rgba(201,168,76,0.06) 0%, transparent 60%),
radial-gradient(ellipse 40% 80% at 10% 80%, rgba(201,168,76,0.04) 0%, transparent 50%),
linear-gradient(160deg, #0E0E0E 0%, #141210 100%);
}

.hero-line {
position: absolute; top: 0; left: 60px;
width: 1px; height: 100%;
background: linear-gradient(to bottom, transparent, var(–gold-dim), transparent);
}

.hero-tag {
font-size: 11px;
letter-spacing: 0.25em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 40px;
position: relative;
z-index: 1;
opacity: 0;
animation: fadeUp 1s 0.3s forwards;
}
.hero-tag::before {
content: ‘’;
display: inline-block;
width: 32px; height: 1px;
background: var(–gold);
vertical-align: middle;
margin-right: 16px;
}

.hero-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(56px, 8vw, 110px);
font-weight: 300;
line-height: 1.0;
color: var(–white);
position: relative; z-index: 1;
opacity: 0;
animation: fadeUp 1s 0.5s forwards;
}
.hero-title em {
font-style: italic;
color: var(–gold);
}

.hero-sub {
font-size: 18px;
font-weight: 300;
color: var(–text-dim);
max-width: 520px;
margin-top: 32px;
position: relative; z-index: 1;
opacity: 0;
animation: fadeUp 1s 0.7s forwards;
line-height: 1.8;
}

.hero-actions {
display: flex; align-items: center; gap: 40px;
margin-top: 56px;
position: relative; z-index: 1;
opacity: 0;
animation: fadeUp 1s 0.9s forwards;
}

.btn-primary {
background: var(–gold);
color: var(–dark);
padding: 18px 48px;
font-size: 12px;
font-weight: 500;
letter-spacing: 0.18em;
text-transform: uppercase;
text-decoration: none;
transition: all 0.3s;
display: inline-block;
}
.btn-primary:hover { background: var(–gold-light); transform: translateY(-2px); }

.hero-scroll {
font-size: 11px;
letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–text-dim);
display: flex; align-items: center; gap: 12px;
}
.hero-scroll::after {
content: ‘’;
display: block;
width: 1px; height: 48px;
background: linear-gradient(to bottom, var(–text-dim), transparent);
}

.hero-stats {
position: absolute; right: 60px; bottom: 100px;
display: flex; flex-direction: column; gap: 32px;
z-index: 1;
opacity: 0;
animation: fadeLeft 1s 1.1s forwards;
}
.hero-stat {
text-align: right;
border-right: 1px solid var(–gold-dim);
padding-right: 24px;
}
.hero-stat-num {
font-family: ‘Cormorant Garamond’, serif;
font-size: 40px;
font-weight: 300;
color: var(–gold);
line-height: 1;
}
.hero-stat-label {
font-size: 10px;
letter-spacing: 0.18em;
text-transform: uppercase;
color: var(–text-dim);
margin-top: 4px;
}

/* ── PROBLEM ───────────────────────────────── */
.section { padding: 120px 60px; position: relative; }

.section-label {
font-size: 10px;
letter-spacing: 0.3em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 20px;
display: flex; align-items: center; gap: 16px;
}
.section-label::before {
content: ‘’;
display: block;
width: 24px; height: 1px;
background: var(–gold);
}

.section-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(36px, 4vw, 58px);
font-weight: 300;
line-height: 1.15;
color: var(–dark);
margin-bottom: 24px;
}
.solution-bg .section-title,
.pricing-bg .section-title,
.author-bg .section-title {
color: var(–white);
}
.section-title em { font-style: italic; color: var(–gold); }

.problem-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 1px;
background: var(–mid);
margin-top: 72px;
border: 1px solid var(–mid);
}

.problem-item {
background: var(–dark2);
padding: 48px 40px;
position: relative;
overflow: hidden;
transition: background 0.4s;
}
.problem-item:hover { background: var(–dark3); }
.problem-item::before {
content: ‘’;
position: absolute; top: 0; left: 0;
width: 3px; height: 0;
background: var(–gold);
transition: height 0.4s;
}
.problem-item:hover::before { height: 100%; }

.problem-num {
font-family: ‘Cormorant Garamond’, serif;
font-size: 72px;
font-weight: 300;
color: rgba(201,168,76,0.08);
line-height: 1;
position: absolute; top: 16px; right: 24px;
}

.problem-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: 22px;
font-weight: 600;
color: var(–white);
margin-bottom: 12px;
}

.problem-desc {
font-size: 14px;
color: var(–text-dim);
line-height: 1.8;
}

/* ── ROZWIĄZANIE ────────────────────────────── */
.solution-bg { background: var(–dark2); }

.solution-inner {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 100px;
align-items: center;
}

.solution-quote {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(28px, 3vw, 42px);
font-weight: 300;
font-style: italic;
line-height: 1.4;
color: var(–white);
border-left: 2px solid var(–gold);
padding-left: 40px;
}

.solution-list { list-style: none; }
.solution-list li {
display: flex; align-items: flex-start; gap: 20px;
padding: 20px 0;
border-bottom: 1px solid rgba(255,255,255,0.04);
font-size: 15px;
color: var(–text);
}
.solution-list li::before {
content: ‘→’;
color: var(–gold);
flex-shrink: 0;
margin-top: 2px;
}

/* ── PROGRAM ───────────────────────────────── */
.program-phases {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 2px;
background: var(–mid);
margin-top: 72px;
}

.phase {
background: var(–dark);
padding: 48px 36px 56px;
position: relative;
overflow: hidden;
}
.phase::after {
content: ‘’;
position: absolute; bottom: 0; left: 0; right: 0;
height: 2px;
background: var(–gold);
transform: scaleX(0);
transform-origin: left;
transition: transform 0.5s;
}
.phase:hover::after { transform: scaleX(1); }

.phase-num {
font-family: ‘Cormorant Garamond’, serif;
font-size: 80px;
font-weight: 300;
color: rgba(201,168,76,0.06);
line-height: 1;
margin-bottom: 24px;
}

.phase-months {
font-size: 10px;
letter-spacing: 0.25em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 16px;
}

.phase-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: 26px;
font-weight: 600;
color: var(–white);
margin-bottom: 20px;
line-height: 1.2;
}

.phase-desc {
font-size: 14px;
color: var(–text-dim);
line-height: 1.8;
}

/* ── PRICING ───────────────────────────────── */
.pricing-bg { background: var(–dark2); }

.pricing-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 2px;
background: var(–mid);
margin-top: 72px;
}

.tier {
background: var(–dark);
padding: 56px 48px;
position: relative;
}

.tier-featured {
background: linear-gradient(160deg, var(–dark3) 0%, #1A1712 100%);
border: 1px solid rgba(201,168,76,0.2);
}

.tier-badge {
font-size: 9px;
letter-spacing: 0.25em;
text-transform: uppercase;
color: var(–dark);
background: var(–gold);
padding: 6px 16px;
display: inline-block;
margin-bottom: 32px;
}

.tier-name {
font-size: 11px;
letter-spacing: 0.25em;
text-transform: uppercase;
color: var(–text-dim);
margin-bottom: 16px;
}

.tier-price {
font-family: ‘Cormorant Garamond’, serif;
font-size: 72px;
font-weight: 300;
color: var(–white);
line-height: 1;
}
.tier-price span {
font-size: 20px;
color: var(–text-dim);
font-family: ‘DM Sans’, sans-serif;
font-weight: 300;
}

.tier-period {
font-size: 13px;
color: var(–text-dim);
margin: 12px 0 40px;
}

.tier-features { list-style: none; }
.tier-features li {
display: flex; align-items: flex-start; gap: 14px;
padding: 12px 0;
border-bottom: 1px solid rgba(255,255,255,0.04);
font-size: 14px;
color: var(–text);
}
.tier-features li::before {
content: ‘✓’;
color: var(–gold);
flex-shrink: 0;
font-size: 12px;
margin-top: 3px;
}

.tier-cta {
display: block;
margin-top: 40px;
padding: 16px;
text-align: center;
font-size: 11px;
letter-spacing: 0.18em;
text-transform: uppercase;
text-decoration: none;
transition: all 0.3s;
}
.tier .tier-cta {
border: 1px solid var(–mid);
color: var(–text-dim);
}
.tier .tier-cta:hover { border-color: var(–gold); color: var(–gold); }
.tier-featured .tier-cta {
background: var(–gold);
color: var(–dark);
font-weight: 500;
}
.tier-featured .tier-cta:hover { background: var(–gold-light); }

/* ── ROI ───────────────────────────────────── */
.roi-box {
background: var(–dark2);
border: 1px solid rgba(201,168,76,0.15);
padding: 60px;
margin-top: 40px;
display: grid;
grid-template-columns: 1fr auto 1fr auto 1fr;
align-items: center;
gap: 40px;
}
.roi-item { text-align: center; }
.roi-num {
font-family: ‘Cormorant Garamond’, serif;
font-size: 48px;
font-weight: 300;
color: var(–gold);
line-height: 1;
}
.roi-label {
font-size: 11px;
letter-spacing: 0.15em;
text-transform: uppercase;
color: var(–text-dim);
margin-top: 8px;
}
.roi-divider {
width: 1px;
height: 80px;
background: var(–mid);
}

/* ── POZYCJONOWANIE VS ──────────────────────── */
.vs-table {
width: 100%;
border-collapse: collapse;
margin-top: 72px;
}
.vs-table th {
padding: 20px 24px;
font-size: 10px;
letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–text-dim);
border-bottom: 1px solid var(–mid);
text-align: left;
}
.vs-table th:last-child {
color: var(–gold);
border-bottom-color: var(–gold);
}
.vs-table td {
padding: 20px 24px;
font-size: 14px;
border-bottom: 1px solid rgba(255,255,255,0.04);
color: var(–text-dim);
vertical-align: top;
}
.vs-table td:first-child { color: var(–text); font-weight: 400; }
.vs-table td:last-child { color: var(–text); }
.vs-table tr:hover td { background: rgba(201,168,76,0.02); }
.check { color: var(–gold); }
.cross { color: #5A3A3A; }

/* ── KANAŁY ─────────────────────────────────── */
.channels-grid {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 2px;
background: var(–mid);
margin-top: 72px;
}

.channel {
background: var(–dark);
padding: 40px 32px;
}

.channel-num {
font-family: ‘Cormorant Garamond’, serif;
font-size: 48px;
font-weight: 300;
color: rgba(201,168,76,0.12);
line-height: 1;
margin-bottom: 20px;
}

.channel-title {
font-size: 11px;
letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 16px;
}

.channel-desc {
font-size: 13px;
color: var(–text-dim);
line-height: 1.8;
}

/* ── AUTOR ──────────────────────────────────── */
.author-bg { background: var(–dark2); }

.author-inner {
display: grid;
grid-template-columns: auto 1fr;
gap: 80px;
align-items: start;
}

.author-photo {
width: 220px;
height: 280px;
flex-shrink: 0;
overflow: hidden;
border: 1px solid rgba(201,168,76,0.25);
position: relative;
}
.author-photo img {
width: 100%;
height: 100%;
object-fit: cover;
object-position: center top;
filter: grayscale(20%) contrast(1.05);
transition: filter 0.4s;
}
.author-photo:hover img { filter: grayscale(0%) contrast(1.05); }
.author-avatar {
width: 160px; height: 160px;
background: linear-gradient(135deg, var(–mid), var(–dark3));
border: 1px solid rgba(201,168,76,0.2);
display: flex; align-items: center; justify-content: center;
flex-shrink: 0;
}
.author-avatar-inner {
font-family: ‘Cormorant Garamond’, serif;
font-size: 48px;
font-weight: 300;
color: var(–gold);
}

.author-name {
font-family: ‘Cormorant Garamond’, serif;
font-size: 42px;
font-weight: 300;
color: var(–white);
margin-bottom: 8px;
}

.author-title {
font-size: 11px;
letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 32px;
}

.author-bio {
font-size: 15px;
color: var(–text);
line-height: 1.9;
max-width: 600px;
}

.author-credentials {
display: flex; gap: 48px;
margin-top: 40px;
}

.credential {
border-left: 1px solid var(–gold-dim);
padding-left: 20px;
}
.credential-val {
font-family: ‘Cormorant Garamond’, serif;
font-size: 28px;
color: var(–gold);
line-height: 1;
}
.credential-label {
font-size: 11px;
color: var(–text-dim);
margin-top: 4px;
letter-spacing: 0.1em;
}

/* ── CTA FINALNE ────────────────────────────── */
.cta-section {
padding: 160px 60px;
text-align: center;
position: relative;
overflow: hidden;
}

.cta-section::before {
content: ‘’;
position: absolute; inset: 0;
background:
radial-gradient(ellipse 80% 60% at 50% 50%, rgba(201,168,76,0.05) 0%, transparent 70%);
}

.cta-label {
font-size: 10px;
letter-spacing: 0.3em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 32px;
display: flex; align-items: center; justify-content: center; gap: 16px;
}
.cta-label::before, .cta-label::after {
content: ‘’;
display: block; width: 40px; height: 1px;
background: var(–gold);
}

.cta-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(44px, 6vw, 80px);
font-weight: 300;
line-height: 1.1;
color: var(–white);
margin-bottom: 24px;
position: relative; z-index: 1;
}
.cta-title em { font-style: italic; color: var(–gold); }

.cta-sub {
font-size: 16px;
color: var(–text-dim);
max-width: 480px;
margin: 0 auto 56px;
line-height: 1.8;
position: relative; z-index: 1;
}

.cta-actions {
display: flex; flex-direction: column; align-items: center; gap: 16px;
position: relative; z-index: 1;
}

.btn-large {
background: var(–gold);
color: var(–dark);
padding: 22px 72px;
font-size: 12px;
font-weight: 500;
letter-spacing: 0.2em;
text-transform: uppercase;
text-decoration: none;
display: inline-block;
transition: all 0.3s;
}
.btn-large:hover { background: var(–gold-light); transform: translateY(-3px); box-shadow: 0 20px 60px rgba(201,168,76,0.2); }

.cta-note {
font-size: 12px;
color: var(–text-dim);
letter-spacing: 0.05em;
}

/* ── FOOTER ─────────────────────────────────── */
footer {
padding: 48px 60px;
border-top: 1px solid var(–mid);
display: flex; align-items: center; justify-content: space-between;
}

.footer-logo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px;
font-weight: 300;
letter-spacing: 0.1em;
color: var(–gold);
}

.footer-text {
font-size: 12px;
color: var(–text-dim);
letter-spacing: 0.05em;
}

/* ── ANIMACJE ───────────────────────────────── */
@keyframes fadeUp {
from { opacity: 0; transform: translateY(30px); }
to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeLeft {
from { opacity: 0; transform: translateX(30px); }
to   { opacity: 1; transform: translateX(0); }
}

.reveal {
opacity: 1;
transform: translateY(0);
transition: opacity 0.7s, transform 0.7s;
}
.reveal.anim {
opacity: 0;
transform: translateY(24px);
}
.reveal.anim.visible {
opacity: 1;
transform: translateY(0);
}

/* ── RESPONSIVE ─────────────────────────────── */
@media (max-width: 900px) {
nav { padding: 20px 24px; }
.hero { padding: 0 24px 80px; }
.hero-stats { display: none; }
.section { padding: 80px 24px; }
.problem-grid, .pricing-grid, .solution-inner,
.program-phases, .channels-grid { grid-template-columns: 1fr; }
.vs-table td:nth-child(2), .vs-table th:nth-child(2),
.vs-table td:nth-child(3), .vs-table th:nth-child(3) { display: none; }
.roi-box { grid-template-columns: 1fr 1fr; padding: 32px; }
.roi-divider { display: none; }
.author-inner { grid-template-columns: 1fr; gap: 40px; }
.author-credentials { flex-wrap: wrap; gap: 24px; }
.cta-section { padding: 100px 24px; }
footer { flex-direction: column; gap: 16px; text-align: center; padding: 32px 24px; }
}

/* ── TESTIMONIALE ───────────────────────────── */
.testimonials-grid {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 2px;
background: var(–mid);
}

.tcard {
background: var(–dark2);
padding: 36px 32px;
transition: background 0.3s;
position: relative;
overflow: hidden;
}
.tcard::before {
content: ‘’;
position: absolute; top: 0; left: 0; right: 0;
height: 2px;
background: var(–gold);
transform: scaleX(0);
transform-origin: left;
transition: transform 0.4s;
}
.tcard:hover { background: var(–dark3); }
.tcard:hover::before { transform: scaleX(1); }

.tcard-wide {
grid-column: span 2;
background: linear-gradient(135deg, var(–dark3), #161410);
border: 1px solid rgba(201,168,76,0.1);
}

.tcard-stars {
font-size: 14px;
color: var(–gold);
margin-bottom: 16px;
letter-spacing: 2px;
}

.tcard-text {
font-family: ‘Cormorant Garamond’, serif;
font-size: 17px;
font-style: italic;
color: var(–text);
line-height: 1.7;
margin-bottom: 20px;
}

.tcard-author {
font-size: 11px;
letter-spacing: 0.12em;
text-transform: uppercase;
color: var(–text-dim);
border-top: 1px solid var(–mid);
padding-top: 16px;
}

@media (max-width: 900px) {
.testimonials-grid { grid-template-columns: 1fr; }
.tcard-wide { grid-column: span 1; }
}

</style>
</head>
<body>

<!-- NAV -->

<nav>
  <a class="nav-logo" href="#">Marcin Dutkiewicz</a>
  <a class="nav-cta" href="#konsultacja">Bezpłatna konsultacja</a>
</nav>

<!-- HERO -->

<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-line"></div>

  <div class="hero-tag">Mentoring 1:1 Premium dla Agentów</div>

  <h1 class="hero-title">
    Przestań pracować<br>
